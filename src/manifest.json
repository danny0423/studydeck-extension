{
  "manifest_version": 3,
  "name": "StudyDeck 單字收集",
  "short_name": "StudyDeck",
  "version": "1.1.0",
  "description": "在任何網站選字、按右鍵，就把單字和那一句例句加到 StudyDeck 的待學習。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["contextMenus", "scripting", "activeTab", "storage", "notifications"],
  "optional_host_permissions": ["https://*/*"]
}
